PORT=4000
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-secret
TRUST_PROXY=1

# Namecheap MySQL (from cPanel → MySQL Databases)
# Host is usually localhost on shared hosting
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_mediconsult
DB_PASSWORD=your-mysql-password
DB_NAME=cpaneluser_mediconsult

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# Optional: lock CORS to your domain
# CORS_ORIGIN=https://yourdomain.com
